# Set these in Netlify: Site configuration → Environment variables.
# (For `netlify dev` locally, copy to .env.)
ADMIN_PASSWORD=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to Netlify's site URL (your custom domain once set).
BASE_URL=https://book.blurredspaces.com
# Optional fixed cookie-signing key (otherwise generated and kept in Netlify Blobs)
SECRET_KEY=
