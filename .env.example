# Copy to .env and fill in. Never commit .env.
PORT=3000
BASE_URL=http://localhost:3000
ADMIN_PASSWORD=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: fixed cookie-signing key (otherwise auto-generated in data/secret.key)
SECRET_KEY=
# Optional: folder for saved Google connections (Render: the disk mount path, e.g. /var/data)
DATA_DIR=
